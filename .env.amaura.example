# Generate each key independently: python -c 'import secrets; print(secrets.token_urlsafe(32))'
AMAURA_FOUNDER_NAME=Akshat
AMAURA_FOUNDER_ID=founder
AMAURA_DATA_DIR=./.amaura-data
JARVIS_DATA_DIR=./.jarvis-data

# Use five different random 32+ byte values.
AMAURA_OPERATOR_KEY=replace-with-independent-random-value
AMAURA_APPROVAL_KEY=replace-with-independent-random-value
AMAURA_REVIEW_ATTESTATION_KEY=replace-with-independent-random-value
AMAURA_PROVIDER_RECEIPT_KEY=replace-with-independent-random-value
JARVIS_API_KEY=replace-with-independent-random-value

# Safe default: local access only.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional worker and notification integrations.
NVIDIA_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# Free, device-only default for the Amaura workforce.
AMAURA_MODEL_MODE=local
AMAURA_LOCAL_MODEL=nova:3b
# Must be a distinct installed model to reduce correlated worker/reviewer errors.
AMAURA_LOCAL_REVIEW_MODEL=qwen2.5-coder:3b
AMAURA_LEASE_SECONDS=900
AMAURA_MAX_ATTEMPTS=2
AMAURA_SANDBOX_MODE=docker
AMAURA_SANDBOX_IMAGE=amaura-sandbox:1.1.0
AMAURA_SANDBOX_MEMORY=1g
AMAURA_SANDBOX_CPUS=1.5
AMAURA_EVIDENCE_DIR=./.amaura-data/evidence
AMAURA_BACKUP_DIR=./.amaura-data/backups

# External providers remain disabled until explicitly enabled and configured.
AMAURA_ENABLE_GMAIL=0
AMAURA_GMAIL_ACCESS_TOKEN=
AMAURA_ENABLE_PUBLICATION=0
AMAURA_PUBLICATION_ENDPOINT=
AMAURA_PUBLICATION_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
